# Server Configuration
PORT=3000
NODE_ENV=development

# Kredensial Admin Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=creatorhub123
JWT_SECRET=rahasia_jwt_creatorhub_ganti_ini_saat_production_2026

# Google Sheets Integration
# Ambil dari URL Google Sheets: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
GOOGLE_SHEET_ID=masukkan_id_spreadsheet_anda_disini
GOOGLE_SHEET_NAME=Creators

# Pilihan A: Menggunakan file kunci JSON Service Account (Direkomendasikan untuk lokal di VS Code)
# Letakkan file JSON yang diunduh dari Google Cloud di root folder proyek
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# Pilihan B: Menggunakan Environment Variable langsung (Opsional jika tanpa file JSON)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
